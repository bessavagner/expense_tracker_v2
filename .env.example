# Django Settings
# Copy this file to .env and fill in real values
# NEVER commit .env to git
#
# Every key below is OPTIONAL unless marked otherwise: settings.py carries a
# working default for each. An EMPTY value means "use the default" — the code
# treats "" and unset the same way — so you can leave a key here without
# breaking anything. Do NOT define the same key twice: the last line wins, and
# an empty duplicate lower down silently blanks a real value above it.

# --- Core ---
# In production: generate a fresh strong key, e.g.
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Match the port you actually serve on. The systemd dev unit uses 8700.
CSRF_TRUSTED_ORIGINS=http://localhost:8700
# The admin lives behind an unguessable path, not /admin/. Trailing slash is
# added by settings.py either way.
ADMIN_URL_PATH=gestao-dev/

# Login lockout (E01): N failures for the same username or IP inside the window
# stop further attempts, including ones with the correct password.
LOGIN_FAILURE_LIMIT=10
LOGIN_FAILURE_WINDOW_MINUTES=15

# --- Database (local dev via Docker Compose) ---
# POSTGRES_PORT is the HOST port docker-compose publishes; the container is
# always on 5432. This project's dev and test database runs on 5433 to stay
# clear of a system Postgres, which is why commands in docs/runbook.md are
# prefixed with POSTGRES_PORT=5433.
POSTGRES_DB=expense_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Supabase connection strings, read by scripts/ (not by settings.py). The
# session pooler is port 5432 and the transaction pooler 6543 — see the
# "Applying a migration to Supabase" section of docs/runbook.md.
SUPABASE_TRANSACTION_POOLER=
SUPABASE_SESSION_POOLER=

# --- Provider API keys ---
# Read directly from the environment by the provider SDKs, not by settings.py.
# Only the ones whose models you actually point at are needed.
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Without this the ESSENTIAL tier resolves to STANDARD instead: a household out
# of credits still gets an answer, just not a cheap one. Set it in Secret
# Manager for production.
OPENROUTER_API_KEY=
# Deprecated alias for OPENAI_API_KEY, still honoured by settings.py because
# Cloud Run maps the secret under this name. Prefer OPENAI_API_KEY; setting
# both is harmless (OPENAI_API_KEY wins).
# LLM_API_KEY=

# --- AI Assistant ---
LLM_MODEL=openai:gpt-5.4-mini
# Modelo do agente único (assistente forte). Se omitido, usa o default do código
# (openai:gpt-5.4). Defina aqui ou no ambiente (ex.: Cloud Run) para trocar.
LLM_ASSISTANT_MODEL=openai:gpt-5.4
# Lê IMAGEM (recibo). Um recibo térmico, girado ou de baixo contraste vai mal
# num modelo leve, por isso o default é um modelo de visão capaz.
LLM_VISION_MODEL=openai:gpt-5.4
# Transcrição de áudio. O fallback existe porque o webm/opus do navegador às
# vezes é rejeitado pelo modelo primário como "corrupted or unsupported";
# whisper-1 é mais tolerante.
LLM_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
LLM_TRANSCRIBE_FALLBACK_MODEL=whisper-1
ASSISTANT_MAX_HISTORY=20
# Abaixo desta confiança o bot confirma o recibo campo a campo em vez de propor
# de uma vez.
ASSISTANT_RECEIPT_MIN_CONFIDENCE=0.6
# Upload ceilings for one chat turn. Keep MAX_REQUEST_BODY_BYTES below in step
# with IMAGES * IMAGE_MB or valid uploads start getting 413s.
ASSISTANT_MAX_IMAGES=5
ASSISTANT_MAX_IMAGE_MB=10
ASSISTANT_MAX_AUDIO_MB=25

# --- Model tiers (E07) ---
# ADVANCED/STANDARD default to LLM_ASSISTANT_MODEL — they deliberately name the
# same model until E09 separates them with an E08 score. ESSENTIAL is the free
# floor a household degrades to when its credits run out; its defaults are a
# free OpenRouter model plus a cheap paid fallback, both checked at
# openrouter.ai on 2026-08-14. Re-check before changing them — never from
# memory (E07 spec D3) — and price whatever you pick in
# assistant/migrations/0019_seed_model_prices.py, or it meters at null forever.
LLM_TIER_ADVANCED=
LLM_TIER_STANDARD=
LLM_TIER_ESSENTIAL=
LLM_TIER_ESSENTIAL_FALLBACK=

# --- Assistant abuse ceilings (E01, renamed in E07) ---
# Rolling-window per-USER ceilings; a rejected turn never reaches a model.
# These REFUSE with a 429 on every tier, including the free one — that is what
# keeps "no unbounded LLM spend" true. Credits are the separate, per-household
# budget that degrades instead of refusing.
# Defaults are ~20x measured peak usage; raise only with a reason.
ASSISTANT_ABUSE_TEXT_PER_HOUR=60
ASSISTANT_ABUSE_TEXT_PER_DAY=300
ASSISTANT_ABUSE_IMAGE_PER_HOUR=15
ASSISTANT_ABUSE_IMAGE_PER_DAY=50

# Request body ceilings (E01), in bytes. Keep MAX_REQUEST_BODY_BYTES above
# ASSISTANT_MAX_IMAGES * ASSISTANT_MAX_IMAGE_MB or valid uploads get 413s.
MAX_REQUEST_BODY_BYTES=62914560
MAX_CSV_UPLOAD_BYTES=10485760

# --- Transactional email (Resend over SMTP) ---
# Leave EMAIL_HOST empty in dev: without it Django uses the console backend,
# which prints the message. Django's own default is SMTP on localhost:25, where
# mail vanishes silently — "e-mail enviado" and an empty inbox.
# EMAIL_HOST_USER is the literal string "resend"; the password is the API key.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=resend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Ledger <nao-responda@localhost>

# --- Finances ---
# First month the projection walks forward from. Moving it rewrites every
# projected balance, so treat it as a data decision, not a tuning knob.
PROJECTION_ORIGIN_MONTH=2025-11

# --- Android TWA ---
# TWA_CERT_FINGERPRINT is the SHA-256 of the Bubblewrap signing key, served in
# /.well-known/assetlinks.json. Without a match the installed app shows a URL
# bar. Comma-separate to rotate keys. Get it with:
#   keytool -list -v -keystore ./android.keystore -alias android | grep -A1 SHA256
TWA_PACKAGE_NAME=com.bessavagner.ledger
TWA_CERT_FINGERPRINT=

# --- Observability (E06) ---
# All optional: absent SENTRY_DSN disables Sentry, absent LOGFIRE_TOKEN
# disables agent tracing. That is the intended local-development state --
# neither should transmit from a laptop.
# SENTRY_DSN=https://key@oNNNNNN.ingest.sentry.io/PROJECT
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=local            # production reads K_REVISION instead
# LOGFIRE_TOKEN=
# LOGFIRE_ENVIRONMENT=development
# Full prompts and completions are captured by default (operator decision,
# 2026-08-14). Set to 0 to turn text capture off without a deploy.
# LOGFIRE_CAPTURE_CONTENT=1
# Receipt PHOTOS are NOT captured by default. Turning this on uploads every
# receipt image to a third party.
# LOGFIRE_CAPTURE_BINARY=0

# --- Test-only knobs (not app config; see docs/testing-conventions.md) ---
# TEST_CLOCK_SHIFT=+1y   # shift the whole suite's clock to surface date bugs
# RUN_LLM_TESTS=1        # allow tests to make REAL, billed provider calls

# --- E08 — model evaluation ---
# Private directory holding the eval receipt photos (see docs/eval-dataset.md).
# Leave empty to run the harness on the tracked fixtures only.
EVAL_FIXTURES_DIR=

# --- Production server ---
# Cloud Run / containers inject PORT (defaults to 8080 in the Dockerfile).
# PORT=8080

# ============================================================
# Production (Supabase + Cloud Run) — uncomment & fill for prod
# ============================================================
# DEBUG=False
# ALLOWED_HOSTS=expenses.your-domain.com
# CSRF_TRUSTED_ORIGINS=https://expenses.your-domain.com
#
# DATABASE_URL overrides the individual POSTGRES_* vars above.
# App runtime  -> Supabase Transaction Pooler (port 6543), sslmode=require:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
# Migrations   -> Supabase direct/Session connection (port 5432); the transaction
#                 pooler does not support everything migrations need:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
